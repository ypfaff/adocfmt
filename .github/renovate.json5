{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [],
  timezone: 'Europe/Berlin',
  schedule: [
    '* * * * 1',
  ],
  minimumReleaseAge: '7 days',
  dependencyDashboard: {
    enabled: true,
  },
  semanticCommits: 'enabled',
  semanticCommitType: 'chore',
  semanticCommitScope: 'deps',
  vulnerabilityAlerts: {
    commitMessageSuffix: '',
    labels: [
      'security',
    ],
  },
  rebaseWhen: 'behind-base-branch',
  postUpdateOptions: [
    'gomodTidy',
  ],
  customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^internal/asciidoctorcases/cases\\.go$/',
      ],
      matchStrings: [
        'const Version = "(?<currentValue>[^"]+)"',
      ],
      depNameTemplate: 'asciidoctor',
      datasourceTemplate: 'rubygems',
    },
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^docs/.+\\.adoc$/',
      ],
      matchStrings: [
        'uses: actions/checkout@(?<currentValue>v\\d+)\\n',
      ],
      depNameTemplate: 'actions/checkout',
      datasourceTemplate: 'github-tags',
      versioningTemplate: 'docker',
    },
  ],
  packageRules: [
    {
      matchManagers: [
        'github-actions',
      ],
      semanticCommitType: 'ci',
    },
    {
      matchFileNames: [
        'tools/actionlint/go.mod',
        'tools/govulncheck/go.mod',
        'tools/htmltest/go.mod',
      ],
      semanticCommitType: 'ci',
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchDepTypes: [
        'action',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'actions',
    },
    {
      matchPackageNames: [
        'ypfaff/adocfmt',
      ],
      extractVersion: '^v(?<version>.+)$',
      schedule: [
        'at any time',
      ],
      minimumReleaseAge: '30 minutes',
    },
    {
      matchDepNames: [
        'go',
      ],
      groupName: 'go',
    },
    {
      matchDepNames: [
        'go',
      ],
      matchUpdateTypes: [
        'patch',
      ],
      schedule: [
        'at any time',
      ],
      minimumReleaseAge: null,
    },
    {
      matchFileNames: [
        'tools/htmltest/go.mod',
      ],
      matchDepTypes: [
        'indirect',
      ],
      enabled: true,
    },
    {
      matchFileNames: [
        'tools/htmltest/go.mod',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      matchDepNames: [
        'java',
      ],
      minimumReleaseAgeBehaviour: 'timestamp-optional',
    },
    {
      matchDepNames: [
        'java',
      ],
      matchUpdateTypes: [
        'major',
      ],
      enabled: false,
    },
    {
      matchPackageNames: [
        'asciidoctor',
      ],
      prBodyNotes: [
        'Follow docs/contributing/testing-strategy.adoc for a new Asciidoctor release.',
      ],
    },
  ],
}
