{{/* No version field: Homebrew reads it from the URL, and brew audit rejects one as redundant. */ -}}
{{define "archive"}}url "{{.URL}}"
      sha256 "{{.SHA256}}"{{end -}}
# frozen_string_literal: true

# Generated by tools/generate-formula on release. Edits are overwritten.
class Adocfmt < Formula
  desc "Opinionated AsciiDoc formatter"
  homepage "https://github.com/{{.Repository}}"
  license "Apache-2.0"

  on_macos do
    on_arm do
      {{template "archive" .Archives.darwin_arm64}}
    end
    on_intel do
      {{template "archive" .Archives.darwin_amd64}}
    end
  end

  on_linux do
    on_arm do
      {{template "archive" .Archives.linux_arm64}}
    end
    on_intel do
      {{template "archive" .Archives.linux_amd64}}
    end
  end

  def install
    bin.install "adocfmt"
  end

  # Formatting a document rather than --version, which passes while the
  # formatter is broken.
  test do
    (testpath/"test.adoc").write("## Section ##\n")
    assert_equal "== Section\n", shell_output("#{bin}/adocfmt #{testpath}/test.adoc")
  end
end
