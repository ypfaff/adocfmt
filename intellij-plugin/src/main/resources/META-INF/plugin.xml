<idea-plugin>
    <id>io.github.ypfaff.adocfmt</id>
    <name>adocfmt</name>
    <vendor url="https://github.com/ypfaff/adocfmt">Yannick Pfaff</vendor>
    <description>Formats AsciiDoc files with adocfmt, an opinionated AsciiDoc formatter.</description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <formattingService implementation="io.github.ypfaff.adocfmt.intellij.AdocfmtFormattingService"/>
        <projectConfigurable parentId="tools" id="io.github.ypfaff.adocfmt" displayName="adocfmt"
                             instance="io.github.ypfaff.adocfmt.intellij.AdocfmtConfigurable"
                             nonDefaultProject="true"/>
        <notificationGroup id="adocfmt refused" displayType="BALLOON"/>
        <notificationGroup id="Enable adocfmt" displayType="STICKY_BALLOON"/>
    </extensions>

    <projectListeners>
        <listener class="io.github.ypfaff.adocfmt.intellij.EnableNotifier"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
