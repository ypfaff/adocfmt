root = true

[*]
insert_final_newline = true

# Some cases test a missing final newline, so their files have to keep it.
[testdata/**]
insert_final_newline = unset

# These cases test trailing whitespace, so their input has to keep it.
[testdata/golden/trailing-whitespace/**]
trim_trailing_whitespace = false

[testdata/golden/blank-lines/whitespace-only-line/**]
trim_trailing_whitespace = false

[testdata/golden/block-delimiters/body-fence-with-trailing-whitespace/**]
trim_trailing_whitespace = false

# The home page of the website shows the trailing whitespace this case removes.
[testdata/golden/website/home-example/**]
trim_trailing_whitespace = false
