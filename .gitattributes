# Line endings are LF in the repository and in every working tree, whatever a
# clone is configured to do.
* text=auto eol=lf

# Except in these cases, where the line endings are what the case tests.
testdata/golden/blank-lines/crlf/* -text
testdata/golden/blank-lines/crlf-no-final-newline/* -text
testdata/golden/block-delimiters/crlf/* -text
testdata/golden/heading-markers/crlf/* -text
testdata/golden/list-markers/crlf/* -text
testdata/golden/one-sentence-per-line/crlf/* -text
testdata/golden/setext-headings/crlf/* -text
testdata/golden/trailing-whitespace/crlf/* -text
